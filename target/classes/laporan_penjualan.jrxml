	<queryString>
		<![CDATA[SELECT id, nama_item, jumlah_jual, harga_jual_total, hpp_saat_terjual, keuntungan, DATE_FORMAT(tanggal_jual, '%d-%m-%Y %H:%i') AS tgl FROM sales_transaction ORDER BY tanggal_jual DESC]]>
